{
  "expo": {
    "name": "Budgy",
    "slug": "budgy",
    "version": "3.7.5",
    "description": "Budgy — Votre coach financier suisse premium. Budgets, LAMal, impôts, IA et épargne pour les 26 cantons. 🇨🇭",
    "primaryColor": "#34D399",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "budgy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "owner": "avdijaalic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/cf75668b-71ba-4bfb-9169-8ad2f572e982"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.budgy.ch.budgy",
      "buildNumber": "25",
      "associatedDomains": [
        "applinks:budgy.ch",
        "applinks:www.budgy.ch"
      ],
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationCategoryType": "public.app-category.finance",
        "CFBundleLocalizations": [
          "fr",
          "en",
          "de",
          "it"
        ],
        "CFBundleDevelopmentRegion": "fr",
        "NSCameraUsageDescription": "Scan receipts to log expenses automatically",
        "NSPhotoLibraryUsageDescription": "Import receipt photos to track expenses",
        "NSPhotoLibraryAddUsageDescription": "Save expense receipts as PDFs to your library",
        "NSFaceIDUsageDescription": "Unlock Budgy securely with Face ID",
        "NSMicrophoneUsageDescription": "Dictate expenses and income with your voice",
        "NSSpeechRecognitionUsageDescription": "Convert your voice into transactions",
        "UIBackgroundModes": [
          "fetch"
        ],
        "UIRequiresFullScreen": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0E1530"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.budgy.ch.budgy",
      "versionCode": 25,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "budgy.ch"
            },
            {
              "scheme": "https",
              "host": "www.budgy.ch"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0E1530"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan receipts to log expenses automatically",
          "microphonePermission": "Dictate expenses and income with your voice",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Dictate expenses and income with your voice",
          "speechRecognitionPermission": "Convert your voice into transactions",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Import receipt photos to track expenses",
          "cameraPermission": "Scan receipts to log expenses automatically",
          "microphonePermission": false
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 5,
            "NSExtensionActivationSupportsFileWithMaxCount": 5,
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1
          },
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "application/pdf"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Budgy securely with Face ID"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#34D399",
          "sounds": []
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "cf75668b-71ba-4bfb-9169-8ad2f572e982"
      },
      "router": {}
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
